rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /oscs/{osc} {
      allow read, write: if request.auth != null && request.auth.uid == osc;
    }
    match /editais/{edital} {
      allow read: if request.auth != null;
      allow write: if false; // Assuming editais are populated via backend admin processes
    }
    match /matches/{match} {
      allow read: if request.auth != null && resource.data.oscId == request.auth.uid;
      allow write: if false; // Matches are generated by the backend Genkit flows
    }
  }
}
